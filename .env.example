# =============================================================================
# SERANA - Variables de Entorno para Desarrollo Local
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena todos los valores marcados con <CAMBIAR>
#   3. Asegurate de que .env este en .gitignore (NUNCA subir al repositorio)
# =============================================================================

# --- Base de Datos PostgreSQL ---
POSTGRES_DB=serana_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CAMBIAR_password_seguro>

# --- Spring Boot DataSource ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-db:5432/serana_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<CAMBIAR_password_seguro>

# --- JWT Security ---
# Generar con: openssl rand -hex 64
# Minimo recomendado: 64 caracteres aleatorios
JWT_SECRET=<CAMBIAR_ejecutar_openssl_rand_hex_64>
JWT_EXPIRATION_MS=86400000

# --- ML Service ---
ML_SERVICE_URL=http://ml-service:8001/api/v1
ML_SERVICE_TIMEOUT_SECONDS=4

# --- CORS (separados por coma, sin espacios) ---
# Desarrollo local: http://localhost:3000,http://localhost:5173
# Produccion: https://serana.upc.edu.pe
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Data Initializer (usuarios de prueba) ---
SERANA_STUDENT_EMAIL=u20201f737@upc.edu.pe
SERANA_STUDENT_PASSWORD=<CAMBIAR_password_estudiante>
SERANA_BIENESTAR_EMAIL=bienestar@upc.edu.pe
SERANA_BIENESTAR_PASSWORD=<CAMBIAR_password_bienestar>
SERANA_ADMIN_EMAIL=admin@serana.upc.edu.pe
SERANA_ADMIN_PASSWORD=<CAMBIAR_password_admin>
